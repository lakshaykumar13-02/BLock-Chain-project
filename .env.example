# =============================================================================
# ChainVault Configuration Template (Staging & Production)
# =============================================================================
# COPY this file to .env and provide environment-specific values.
# NEVER commit real passwords, secrets, private keys, or credentials to Git.

# -----------------------------------------------------------------------------
# 1. Environment & Operational Mode
# -----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=staging

# Enforces strict persistent database mode (fails closed if MongoDB is offline).
# In staging and production, this MUST be set to true.
REQUIRE_PERSISTENT_STORAGE=true

# Database backend engine selection (Options: firestore, mongodb)
# Primary Staging Database: firestore (Google Cloud Firestore via Application Default Credentials or Secret File)
# Authoritative Rollback Source: mongodb (Local MongoDB or Atlas)
DATABASE_BACKEND=firestore

# -----------------------------------------------------------------------------
# 2. Database Persistence (Cloud Firestore or MongoDB Rollback)
# -----------------------------------------------------------------------------
# [A] Google Cloud Firestore (Primary Staging Engine)
FIREBASE_PROJECT_ID=chainvault-staging
FIRESTORE_DATABASE_ID=(default)
# Path to service account JSON keyfile (On Render, uploaded as Secret File to /etc/secrets/gcp-service-account.json):
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp-service-account.json
# For local offline development with Firestore Emulator (bypasses all GCP auth):
# FIRESTORE_EMULATOR_HOST=localhost:8080

# [B] MongoDB (Authoritative Rollback Source / Atlas replica set)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chainvault_staging

# -----------------------------------------------------------------------------
# 3. Authentication & Security (JWT & RBAC)
# -----------------------------------------------------------------------------
# Cryptographically secure 256-bit random string (e.g. generated via: openssl rand -hex 32)
# The application will refuse to start in production if this matches the default key.
JWT_SECRET=replace_with_cryptographically_secure_random_key_min_32_chars
JWT_EXPIRE_MINUTES=60

# Initial account credentials for bootstrap seeding (Required >= 12 chars in production)
SUPER_ADMIN_INITIAL_USERNAME=superadmin
SUPER_ADMIN_INITIAL_PASSWORD=replace_with_secure_super_admin_password_min_12_chars
ADMIN_INITIAL_PASSWORD=replace_with_secure_admin_password_min_12_chars
INVESTIGATOR_INITIAL_PASSWORD=replace_with_secure_investigator_password_min_12_chars

# -----------------------------------------------------------------------------
# 4. Blockchain & Smart Contract Anchoring (EVM Testnet / Sepolia)
# -----------------------------------------------------------------------------
# JSON-RPC Provider URL (e.g. https://sepolia.infura.io/v3/YOUR_INFURA_KEY or Alchemy)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Chain ID: 11155111 for Ethereum Sepolia Testnet, 31337 for local Hardhat node
BLOCKCHAIN_CHAIN_ID=11155111

# Deployed EvidenceRegistryV2 contract address on the target network (0x...)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Dedicated deployer credentials for Hardhat scripts (NEVER commit real keys)
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# SEPOLIA_PRIVATE_KEY=your_64_character_hex_private_key_without_0x
# Safety Guard: Set to true only when explicitly executing live transaction broadcast
DEPLOY_BROADCAST=false

# -----------------------------------------------------------------------------
# 5. Persistent File Storage (Render Persistent Disk / Cloud Mount)
# -----------------------------------------------------------------------------
# For Render Persistent Disk mounted at /var/data (Staging):
# STORAGE_PATH=/var/data/evidence
# REPORTS_PATH=/var/data/reports
# For Local Development:
STORAGE_PATH=storage/evidence
REPORTS_PATH=generated_reports

# -----------------------------------------------------------------------------
# 6. Public Verification & Frontend Origins (CORS & QR Codes)
# -----------------------------------------------------------------------------
# Base URL for public QR code verification links embedded in forensic PDF reports
# (e.g. https://chainvault-staging.onrender.com)
PUBLIC_VERIFICATION_URL_BASE=https://chainvault-staging.onrender.com
LOCAL_VERIFICATION_URL_BASE=http://localhost:8000
ALLOW_LOCAL_QR_LINKS=false

# Comma-separated list of allowed CORS origins for browser requests
# (Include your Render static site domain or custom domain)
CORS_ORIGINS=https://chainvault-frontend.onrender.com,http://localhost:5500,http://localhost:8000

# -----------------------------------------------------------------------------
# 7. Reverse Proxy & Rate Limiting IP Resolution
# -----------------------------------------------------------------------------
# Comma-separated list of trusted reverse proxy IP addresses (e.g. 127.0.0.1, 10.0.0.1)
# X-Forwarded-For is ONLY accepted when incoming connection originates from these IPs.
TRUSTED_PROXIES=127.0.0.1,::1
